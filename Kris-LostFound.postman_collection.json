  "item": [
    {
      "name": "01 Signup user A (201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/signup",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Kristy\",\n  \"email\": \"kristy@test.ca\",\n  \"password\": \"secret123\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j = pm.response.json();",
              "if (j.token) pm.collectionVariables.set('tokenA', j.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Signup user B (201)",
      "request": {
        "method": "POST",
